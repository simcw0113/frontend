# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Build stamp. Rewritten by npm run build and kept out of the page.
src/lib/buildMeta.generated.ts

# production
/build

# misc
.DS_Store
*.pem

# Local Cursor project rules. Stay on this machine; do not commit.
.cursor/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# per-build id written by next build (next.config.ts)
/.deployment-id

.claude/settings.local.json
